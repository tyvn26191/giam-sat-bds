# Copy to apps/web/.env.local for `npm run dev:web` against a real Firebase project.
# Values: Firebase console → Project settings → Your apps → Web app (they are public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# 1 = use the local Auth/Firestore emulators (set automatically by `npm run dev`).
VITE_USE_EMULATOR=0
