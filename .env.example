# Worker environment variables. On Cloud Run they are set by deploy/03-deploy-worker.sh
# (secrets from Secret Manager). Locally, `npm run dev` reads an optional root .env
# (git-ignored) on top of safe defaults: emulators, mock sites, dry-run notifications.

# --- Secrets (Secret Manager in production; never commit real values) -----------------
TELEGRAM_BOT_TOKEN=            # from @BotFather. Empty locally → notifications are printed (dry run)
SMTP_PASS=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=

# --- Access -------------------------------------------------------------------------------
ADMIN_EMAILS=you@example.com   # verified emails promoted to admin on first sign-in
MEMBER_EMAILS=                 # comma list; "@domain.jp" approves a whole domain
MAX_PROPERTIES_PER_USER=500

# --- Notifications ---------------------------------------------------------------------
APP_URL=https://your-project.web.app   # links in Telegram/email ("Xem lịch sử")
NOTIFY_DRY_RUN=false                   # true = log messages instead of sending
EMAIL_PROVIDER=none                    # none | smtp | resend | sendgrid | mailgun
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SECURE=                           # true for port 465
MAILGUN_DOMAIN=
MAILGUN_REGION=us                      # us | eu

# --- Fetching / politeness --------------------------------------------------------------
USER_AGENT=                            # default: PropertyWatchBot/1.0 (+APP_URL; personal property price monitor)
HTTP_TIMEOUT_MS=20000
MAX_HTML_BYTES=5242880
ENABLE_BROWSER=false                   # Playwright fallback tier (Docker image includes Chromium)
BROWSER_TIMEOUT_MS=30000
CHROMIUM_PATH=                         # local Chrome/Edge path if you run the browser tier outside Docker
MAX_CONCURRENT_CHECKS=4                # global (admin can override in Settings → system config)
PER_DOMAIN_CONCURRENCY=1               # 1–2 requests at a time per site
DOMAIN_MIN_SPACING_MS=2000             # gap between two requests to the same host (+ jitter)
DOMAIN_JITTER_MS=1000
RUN_BUDGET_MS=240000                   # a scheduler tick stops starting checks after this
MAX_PROPERTIES_PER_RUN=300

# --- Scheduler auth (Cloud Run) -----------------------------------------------------------
TASKS_AUTH=oidc                        # "none" only for local development (refused on Cloud Run)
TASKS_AUDIENCE=https://gsb-worker-123456789.asia-northeast1.run.app
SCHEDULER_SA_EMAIL=gsb-scheduler@your-project.iam.gserviceaccount.com

# --- Storage / logs -----------------------------------------------------------------------
ARTIFACT_BUCKET=                       # optional GCS bucket for screenshots / HTML of important changes
ENABLE_SCREENSHOTS=false
SAVE_HTML_ON_CHANGE=false
LOG_CHECKS=all                         # all | changes (only changes/errors → fewer Firestore writes)
LOG_RETENTION_DAYS=14
LOG_LEVEL=info

# --- Local development only -----------------------------------------------------------------
MOCK_FETCH_DIR=                        # serve packages/parser/fixtures instead of the internet ("off" to disable in npm run dev)
DEV_TICK_SECONDS=60                    # internal scheduler tick
