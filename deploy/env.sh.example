# Copy to deploy/env.sh and edit. deploy/env.sh is git-ignored. No secrets here (secrets go to Secret Manager).
export PROJECT_ID="your-firebase-project-id"
export REGION="asia-northeast1"            # Tokyo: close to the target sites
export SERVICE="gsb-worker"                # must match firebase.json hosting rewrite serviceId
export REPO="gsb"                          # Artifact Registry repository
export ADMIN_EMAILS="you@example.com"      # verified emails that become admin on first sign-in
export MEMBER_EMAILS=""                    # optional: "a@x.com,@family.jp" (auto-approved members)
export ENABLE_BROWSER="true"               # Playwright fallback tier (needs 2Gi memory)
export ARTIFACT_BUCKET=""                  # optional: "${PROJECT_ID}-gsb-artifacts" keeps screenshots/HTML of important changes
export EMAIL_PROVIDER="none"               # none | smtp | resend | sendgrid | mailgun
export EMAIL_FROM=""                       # e.g. "Property Watch <watch@example.com>"
export SMTP_HOST="" SMTP_PORT="587" SMTP_USER=""   # only for EMAIL_PROVIDER=smtp (password → Secret Manager)
export MAILGUN_DOMAIN=""                   # only for EMAIL_PROVIDER=mailgun

# Derived — do not edit
export WORKER_SA="gsb-worker@${PROJECT_ID}.iam.gserviceaccount.com"
export SCHEDULER_SA="gsb-scheduler@${PROJECT_ID}.iam.gserviceaccount.com"
